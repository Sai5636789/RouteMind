# Copy to .env and adjust. Local-development values only — never commit .env
# with real credentials, and never reuse these defaults beyond local dev.
POSTGRES_DB=routemind
POSTGRES_USER=routemind
POSTGRES_PASSWORD=routemind_dev
POSTGRES_PORT=5432
REDIS_PORT=6379
BACKEND_PORT=8080
FRONTEND_PORT=4200
# GPS simulator (see README, Real-time tracking)
TRACKING_ENABLED=true
TRACKING_TICK_MILLIS=5000
TRACKING_SPEED_KMH=40
# Road routing (see README, Road routing). OSRM runs as its own compose
# service; the backend reaches it on the compose network at osrm:5000.
# After `docker compose up`, the API answers at localhost:8080 and the
# router at localhost:5000 (OSRM_PORT). Routing is optional: the app
# starts and the map works without it, with straight lines.
ROUTING_ENABLED=true
OSRM_BASE_URL=http://osrm:5000
OSRM_PROFILE=driving
OSRM_PORT=5000
